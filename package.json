{
  "name": "shipnote",
  "version": "0.2.0",
  "description": "Git 태그에서 릴리스 노트·변경 보고서·서명된 전달 패키지를 만드는 CLI",
  "type": "module",
  "bin": {
    "shipnote": "dist/cli.js"
  },
  "files": [
    "dist",
    "web/dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "shipnote": "node src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sample": "node scripts/make-sample-repo.mjs",
    "web:dev": "vite web",
    "web:build": "vite build web",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build && npm run web:build"
  },
  "license": "MIT",
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
